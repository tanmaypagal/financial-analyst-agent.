# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=REPLACE_WITH_A_TOOL_CALLING_MODEL   # any OpenAI chat model that supports function calling; swap freely, no code change

# Eval only: the LLM judge. Must be a DIFFERENT model from OPENAI_MODEL.
JUDGE_MODEL=REPLACE_WITH_A_DIFFERENT_MODEL

# Optional
OPENAI_REASONING_EFFORT=low       # minimal|low|medium|high - lower = faster/cheaper on reasoning models (gpt-5 family)
OPENAI_MAX_RETRIES=6             # SDK retries with backoff on rate-limit (429) / 5xx
MAX_TOOL_ITERATIONS=8          # tool-use loop cap
OPENAI_TIMEOUT=120             # seconds per LLM request
AGENT_TIMEOUT_S=300            # seconds for a whole agent run (LLM + tools); 504 from the API, AgentTimeoutError from run_agent
# MCP_SERVER_URL=http://127.0.0.1:8765/mcp   # use a running streamable-HTTP MCP server instead of spawning one over stdio
# FINANCE_DB=data/finance.db
# AGENT_TODAY=2026-09-21       # pin "today" for staleness calculations (tests / reproducible evals)
